# Twilio API credentials
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TO_NUMBER=+1987654321

# Video source:
# - Set to an integer (e.g. 0) for webcam.
# - Set to an RTSP link (e.g. rtsp://username:password@ip_address:port/h264_stream) for CCTV.
VIDEO_SOURCE=0

# Camera mode (webcam, cctv, auto)
CAMERA_MODE=auto

# Cooldown between SMS alerts in seconds (default is 300 seconds / 5 minutes)
COOLDOWN_SECONDS=300

# Cooldown between saving captured intruder photos in seconds (default is 10 seconds)
CAPTURE_COOLDOWN_SECONDS=10

# Face recognition tolerance. Lower values are stricter (default: 0.6)
TOLERANCE=0.6
